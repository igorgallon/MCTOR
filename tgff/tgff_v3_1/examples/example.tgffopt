tg_cnt 5                      #numero de grafos a serem gerados
task_cnt 5 1                  #numero medio de tarefas que cada grafo possui (media, variaçao +/-)
task_degree 4 2               #numero maximo de arcos entrada, saida
period_mul 1, 1               
tg_write                      #armazena as tasks dos grafos (no arquivo .tgff)
pe_write                      #armazena informacao PE (no arquivo .tgff)

Tabela de transmissao (vertices)
table_label COMMUN            #nome da label
table_cnt 5
type_attrib exec_time 50 20   
trans_write

